# Used by docker-compose.yml and by the backend. Copy to .env and fill in.

# REQUIRED: JWT signing secret, 16+ chars. Anyone who knows it can log in as staff. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: database password (default: rank). Postgres only accepts connections from this machine.
# Note: it's fixed when the database is first created; changing it later won't change the real password.
# POSTGRES_PASSWORD=

# App port. Bound to 127.0.0.1 by default, put nginx/Caddy in front.
# Set APP_BIND=0.0.0.0 to expose it directly.
APP_PORT=3000
APP_BIND=127.0.0.1

# Only if the frontend is hosted on another domain
CORS_ORIGIN=

# Local dev (npm run dev): backend port, default 3000. Change it if another app already uses 3000.
# PORT=3001
